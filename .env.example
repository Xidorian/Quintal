# Enrichment API keys (Phase 3 — not needed for the step-1 brain).
# OpenRouteService free key for walking routes: https://openrouteservice.org/dev/#/signup
OPENROUTESERVICE_API_KEY=

# Nominatim requires a contact identifier in the User-Agent (usage policy).
NOMINATIM_USER_AGENT=quintal-rental-finder (xidorian@gmail.com)

# --- Shared preferences store (the 👍/👎 + reason log Malia writes from the hosted app) ---
# Without BOTH of these the CLIs read the LOCAL data/preferences.json instead of the shared
# Gist — so `quintal.feedback report` would harden the next pull off an empty log and say
# nothing is wrong. The report prints which store it read; check that line before trusting it.
# Same two values as .streamlit/secrets.toml / the Streamlit Cloud dashboard.
#
# The private Gist holding preferences.json — its id is the hash in the gist URL.
QUINTAL_GIST_ID=
# A fine-grained GitHub token with **Gists: read and write** and nothing else.
QUINTAL_GITHUB_TOKEN=
